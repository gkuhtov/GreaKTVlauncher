<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <LinearLayout
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E6121828"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Быстрые настройки"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Всё нужное — под рукой"
            android:textColor="#8FA0B5"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/lv_quick_settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:choiceMode="singleChoice"
            android:listSelector="@drawable/aero_banner_card" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⭘ Выбрать    ◀ Закрыть"
            android:textColor="#78879E"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
