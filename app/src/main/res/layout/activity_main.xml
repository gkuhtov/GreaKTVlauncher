<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arc_bg"
    android:orientation="horizontal">

    <!-- Левая панель навигации (Navigation Rail в стиле Arc) -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:background="@drawable/arc_sidebar_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Логотип / Название Arc -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            android:text="ARC TV"
            android:textColor="#58A6FF"
            android:textSize="20sp" />

        <!-- Пункты меню левого сайдбара -->
        <TextView
            android:id="@+id/nav_all_apps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/arc_sidebar_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Все приложения"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/nav_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/arc_sidebar_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Настройки ТВ"
            android:textColor="#8B949E"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Индикатор количества приложений внизу сайдбара -->
        <TextView
            android:id="@+id/tv_sidebar_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif"
            android:text="0 APPS"
            android:textColor="#485466"
            android:textSize="12sp"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- Основное содержимое экрана -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="32dp"
        android:paddingEnd="36dp">

        <!-- Верхний статус-блок: Часы и Дата -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="12:00"
                    android:textColor="#FFFFFF"
                    android:textSize="52sp" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:fontFamily="sans-serif"
                    android:text="Пятница, 24 октября"
                    android:textColor="#7A8CA3"
                    android:textSize="15sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Заголовок рабочей области -->
        <TextView
            android:id="@+id/tv_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:text="УСТАНОВЛЕННЫЕ ПРИЛОЖЕНИЯ"
            android:textColor="#485466"
            android:textSize="12sp" />

        <!-- Сетка приложений с D-Pad навигацией -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="40dp" />

    </LinearLayout>

</LinearLayout>
