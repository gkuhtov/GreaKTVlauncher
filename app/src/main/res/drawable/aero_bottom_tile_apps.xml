<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#3D2A7A" android:endColor="#1E4A9A" android:type="linear" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#2A1F5C" android:endColor="#1A3A7A" android:type="linear" />
            <stroke android:width="1dp" android:color="#2A3550" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
